@startuml
skinparam backgroundColor #FEFEFE
skinparam sequenceArrowThickness 2

actor Cliente
participant "Arequipa\n(Coordinador)" as AQP
participant "Cusco\n(Participante)" as CUS
participant "Trujillo\n(Participante)" as TRU

== Fase 1: Votación (PREPARE) ==

Cliente -> AQP : transferencia(monto, origen, destino)
activate AQP

AQP -> CUS : PREPARE
activate CUS
CUS --> AQP : YES (voto afirmativo)
deactivate CUS

AQP -> TRU : PREPARE
activate TRU
TRU --> AQP : YES (voto afirmativo)
deactivate TRU

note right of AQP
  Todos los nodos votan YES
  El coordinador decide COMMIT
end note

== Fase 2: Decisión (COMMIT) ==

AQP -> AQP : Decision: COMMIT

AQP -> CUS : COMMIT
activate CUS
CUS --> AQP : ACK
note left of CUS
  Transacción confirmada
  en Cusco
end note
deactivate CUS

AQP -> TRU : COMMIT
activate TRU
TRU --> AQP : ACK
note left of TRU
  Transacción confirmada
  en Trujillo
end note
deactivate TRU

AQP -> AQP : Confirmar localmente

AQP --> Cliente : OK - Transferencia completada

note right of AQP
  Todas las ramas confirman:
  Saldos consistentes en
  Arequipa, Cusco y Trujillo
end note

@enduml
